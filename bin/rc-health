#!/usr/bin/env bash
# Health check for every enabled claude-rc@<profile>. Run by claude-rc-health.timer as root.
#
# Per profile:
#   healthy   = unit active AND tmux session present AND a `claude` process in the unit
#               AND no fatal pattern in the last 60 log lines
#   miss      = any of the first three false   -> reset-failed and restart the unit; alert on 2
#               consecutive misses. Every check retries, so a server systemd gave up on recovers
#               once the cause (an outage, say) clears.
#   degraded  = fatal pattern in the log        -> alert once per distinct pattern, restart
#   disconnected = up, but the client's last connection line is an error -> no restart (it is
#               retrying; a restart does not fix the network); alert once offline DISCONNECT_ALERT_AFTER s
# State in /var/lib/claude-rc/health-<profile>.json so alerts don't repeat every 2 min.
#
#   rc-health --ready   read-only: exit 0 once every server is healthy and has been up 10 s.
#                       No restarts, alerts or state (make deploy polls it; a miss here must not
#                       restart a server that is still starting).
# That dir is root-only; the log dir is profile-writable, so logs are only touched as the profile.
set -uo pipefail
# rc-alert and ntfy-send live here; `pct exec` and other bare shells leave it off PATH.
export PATH="/usr/local/bin:$PATH"

STATE_DIR=/var/lib/claude-rc
LOG_DIR=/var/log/claude-rc
MISS_ALERT_AT="${MISS_ALERT_AT:-2}"
DISCONNECT_ALERT_AFTER="${DISCONNECT_ALERT_AFTER:-240}"
# Patterns Claude Code prints when Remote Control is broken in a way a restart won't fix.
FATAL_RE='Remote credentials fetch failed|requires a claude.ai subscription|full-scope login token|disabled by your organization|Remote Control isn.t enabled|Couldn.t verify Remote Control eligibility|giving up'

# Enabled template instances are symlinks in the wants dir; list-unit-files does not list them.
mapfile -t profiles < <(ls /etc/systemd/system/multi-user.target.wants/ 2>/dev/null \
  | sed -nE 's/^claude-rc@(.+)\.service$/\1/p')
[ ${#profiles[@]} -eq 0 ] && { echo "no enabled claude-rc@ instances"; exit 0; }

# Verdicts reach the journal as rc-health: through stdout from the timer's unit, or through
# logger when run by hand, so rcctl sees both.
say() { echo "$1"; [ -n "${INVOCATION_ID:-}" ] || logger -t rc-health "$1" 2>/dev/null || true; }

# Sets active, has_tmux, has_proc, fatal and offline (seconds, empty when connected) for profile $1.
probe() {
  local p="$1"
  active=$(systemctl is-active "claude-rc@$p" 2>/dev/null || true)
  has_tmux=no; has_proc=no
  # A hung server (frozen cgroup) blocks tmux's reply: a probe that times out is a miss, not a hang.
  # Output to /dev/null so a client left waiting on the frozen server holds no pipe of ours.
  if timeout -k 2 10 sudo -u "$p" -H tmux -L "rc-$p" has-session -t rc >/dev/null 2>&1; then has_tmux=yes; fi
  if systemctl show -p ControlGroup --value "claude-rc@$p" | grep -q . \
     && pgrep -u "$p" -f 'claude remote-control|claude-code' >/dev/null 2>&1; then has_proc=yes; fi

  fatal=""; offline=""
  if [ -f "$LOG_DIR/$p.log" ]; then
    fatal=$(tail -n 60 "$LOG_DIR/$p.log" | grep -oE "$FATAL_RE" | tail -n1 || true)
    # While the client retries, the process stays up; until it gives up (about 11 min) its last
    # connection line is the only sign of an outage. ANSI stripped: the status line is redrawn.
    local last
    last=$(tail -n 200 "$LOG_DIR/$p.log" | sed 's/\x1b\[[0-9;?]*[A-Za-z]//g' \
      | grep -aoE 'Connection error, retrying in [0-9.]+s \([0-9]+s elapsed\)|Reconnected after|Connected · ' | tail -n1 || true)
    case "$last" in "Connection error"*) offline=$(sed -E 's/.*\(([0-9]+)s elapsed\)/\1/' <<<"$last") ;; esac
  fi
}

if [ "${1:-}" = --ready ]; then
  for p in "${profiles[@]}"; do
    probe "$p"
    up=$(systemctl show -p ActiveEnterTimestamp --timestamp=unix --value "claude-rc@$p" 2>/dev/null | tr -d @)
    [ "$active" = active ] && [ $has_tmux = yes ] && [ $has_proc = yes ] && [ -z "$fatal" ] \
      && [ -n "$up" ] && [ $(( $(date +%s) - up )) -ge 10 ] || exit 1
  done
  exit 0
fi

rc=0
for p in "${profiles[@]}"; do
  state="$STATE_DIR/health-$p.json"
  [ -f "$state" ] || echo '{"misses":0,"alerted":false,"degraded":""}' > "$state"
  misses=$(jq -r .misses "$state"); alerted=$(jq -r .alerted "$state"); degraded=$(jq -r .degraded "$state")
  since=$(jq -r '.offline // 0' "$state")
  probe "$p"

  if [ "$active" = active ] && [ $has_tmux = yes ] && [ $has_proc = yes ] && [ -z "$fatal" ] && [ -n "$offline" ]; then
    rc=1
    # The log line's elapsed lags by up to one retry interval, so keep the earliest start seen.
    now=$(date +%s); start=$((now - offline))
    [ "$since" -gt 0 ] && [ "$since" -lt "$start" ] && start=$since
    say "$p: disconnected $((now - start))s (reconnecting)"
    if [ $((now - start)) -ge "$DISCONNECT_ALERT_AFTER" ] && [ "$alerted" != true ]; then
      PROFILE=$p rc-alert disconnected "$(( (now - start) / 60 )) min" && alerted=true
    fi
    jq --argjson s "$start" --argjson a "$alerted" '.offline=$s | .alerted=(.alerted or $a)' "$state" > "$state.tmp" && mv "$state.tmp" "$state"
    continue
  fi

  if [ "$active" = active ] && [ $has_tmux = yes ] && [ $has_proc = yes ] && [ -z "$fatal" ]; then
    if [ "$alerted" = true ] || [ "$misses" -gt 0 ] || [ -n "$degraded" ] || [ "$since" -gt 0 ]; then
      # State moves on only once an alert is sent: silenced (exit 3) or failed, it retries next check.
      if [ "$alerted" != true ] || PROFILE=$p rc-alert recovered; then
        echo '{"misses":0,"alerted":false,"degraded":""}' > "$state"
      else
        # The outage is over even if its "recovered" push is not: the next outage's urgent alert sends.
        jq '.urgent=false' "$state" > "$state.tmp" && mv "$state.tmp" "$state"
      fi
    fi
    say "$p: healthy"
    continue
  fi

  rc=1
  if [ -n "$fatal" ]; then
    say "$p: degraded ($fatal)"
    if [ "$degraded" != "$fatal" ]; then
      # Not sent (silenced or failed): the restart below clears the log, so only a pattern that
      # comes back alerts later. A real login failure does.
      if PROFILE=$p rc-alert degraded "$fatal"; then
        jq --arg f "$fatal" '.degraded=$f | .alerted=true' "$state" > "$state.tmp" && mv "$state.tmp" "$state"
      fi
    fi
    # A restart clears a transient; a real auth problem will show the same pattern again (no re-alert).
    sudo -u "$p" truncate -s 0 "$LOG_DIR/$p.log" || true
    systemctl reset-failed "claude-rc@$p" 2>/dev/null || true
    systemctl restart "claude-rc@$p" || true
    continue
  fi

  misses=$((misses + 1))
  say "$p: miss $misses (active=$active tmux=$has_tmux proc=$has_proc)"
  # reset-failed first: once systemd has hit the start limit (an outage longer than the client's
  # retries), a plain restart is refused and the server would stay down after the cause clears.
  systemctl reset-failed "claude-rc@$p" 2>/dev/null || true
  systemctl restart "claude-rc@$p" || true
  if [ "$misses" -ge "$MISS_ALERT_AT" ] && [ "$alerted" != true ]; then
    PROFILE=$p rc-alert down "$misses" && alerted=true
  fi
  # .alerted or $a: claude-rc-alert@ may have set it since this check read the state.
  jq --argjson m "$misses" --argjson a "$alerted" '.misses=$m | .alerted=(.alerted or $a)' "$state" > "$state.tmp" && mv "$state.tmp" "$state"
done
exit $rc
