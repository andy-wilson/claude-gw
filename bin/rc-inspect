#!/usr/bin/env bash
# Read a profile's sessions and worktrees for rcctl, and prune finished worktrees. Run as root
# via sudo (exact commands in systemd/sudoers.d/claude-rc); it re-runs itself as the profile,
# because profile directories are 0700 and root must not follow paths the profile controls.
#   rc-inspect <profile> sessions    JSON lines: each session of the last 36 h, with recent activity
#   rc-inspect <profile> worktrees   each worktree: merged into main, clean, in use, branch, path
#   rc-inspect <profile> prune       remove worktrees that are merged, clean and not in use
set -euo pipefail

# Working directories of the profile's Claude session processes (not the Remote Control server).
session_cwds() {
  local d cmd
  for d in /proc/[0-9]*; do
    cmd="$(tr '\0' ' ' < "$d/cmdline" 2>/dev/null)" || continue
    case "$cmd" in *remote-control*) continue ;; *claude*) readlink "$d/cwd" 2>/dev/null || true ;; esac
  done
}

# Recent activity and where the session ran, from the transcript's tail (bounded, newest first).
# Lines are parsed one by one, so a partial last line is skipped.
# shellcheck disable=SC2016  # jq program
TAIL_JQ='[inputs | fromjson? | select(type == "object")] as $r
| { cwd: ([$r[] | .cwd // empty] | last // ""),
    branch: ([$r[] | .gitBranch // empty] | last // ""),
    activity: ([$r[] | select(.type == "user" or .type == "assistant") | .type as $k | (.timestamp // "") as $t
      | (.message.content | if type == "string" then [{type: "text", text: .}] elif type == "array" then . else [] end)[]
      | if .type == "text" then {ts: $t, kind: $k, text: .text}
        elif .type == "tool_use" then {ts: $t, kind: "tool", text: (.name + " " + ((.input.command // .input.file_path // .input.pattern // .input.description // .input.url // (.input | tostring)) | tostring))}
        else empty end
      | .text |= (gsub("\\s+"; " ") | .[0:300])] | .[-50:] | reverse) }'
# shellcheck disable=SC2016
HEAD_JQ='[limit(200; inputs | fromjson? | select(type == "object"))] as $r
| { started: ([$r[] | .timestamp // empty] | first // ""),
    prompt: ([$r[] | select(.type == "user" and (.message.content | type) == "string") | .message.content] | first // "" | gsub("\\s+"; " ") | .[0:120]) }'

# One JSON object per session whose transcript changed in the last 36 h (the page keeps today's
# in the viewer's timezone), newest first, at most 30.
sessions() {  # <config dir>
  cd "$1/projects" 2>/dev/null || return 0
  local cwds f id last head tail live dirty cwd
  cwds="$(session_cwds)"
  # Paths keep their ./ prefix: project directories start with "-", which commands read as options.
  find . -mindepth 2 -maxdepth 2 -name '*.jsonl' -mmin -2160 -printf '%T@ %p\n' | sort -rn | awk 'NR <= 30' |
  while read -r _ f; do
    id="${f##*/}"; id="${id%.jsonl}"
    last="$(date -u -r "$f" +%FT%TZ)"
    head="$(head -n 200 "$f" | jq -Rnc "$HEAD_JQ")" || head='{}'
    tail="$(tail -n 400 "$f" | jq -Rnc "$TAIL_JQ")" || tail='{}'
    cwd="$(printf '%s' "$tail" | jq -r '.cwd // ""')"
    # Live: a Claude process works in its directory, or the transcript changed in the last 5 min.
    live=false
    if [ -n "$cwd" ] && printf '%s\n' "$cwds" | awk -v p="$cwd" '$0 == p || index($0, p "/") == 1 {f=1} END {exit !f}'; then live=true; fi
    [ -n "$(find "$f" -mmin -5)" ] && live=true
    dirty=false
    [ -n "$cwd" ] && [ -n "$(git -C "$cwd" status --porcelain 2>/dev/null)" ] && dirty=true
    jq -nc --arg id "$id" --arg last "$last" --argjson head "$head" --argjson tail "$tail" \
      --argjson live "$live" --argjson dirty "$dirty" \
      '{id: $id, last: $last, live: $live, dirty: $dirty} + $head + $tail'
  done
}

# One tab-separated line per linked worktree: path, branch, merged, clean, in use.
#   merged: the branch is in main (a new session's untouched branch is too, hence "in use")
#   clean:  no changed, untracked or ignored files (worktree removal deletes ignored ones)
#   in use: a profile process has its cwd inside it, or transcripts for it or a subdirectory
#           changed in the last 24 h
scan() {  # <config dir> <workdir>
  cd "$2"
  local cwds path branch merged clean inuse st tdir
  git show-ref -q --verify refs/heads/main || { echo "no main branch in $2" >&2; return 1; }
  cwds="$(for c in /proc/[0-9]*/cwd; do readlink "$c" || true; done 2>/dev/null)"
  git worktree list --porcelain |
    awk '/^worktree /{p=substr($0,10); b=""} /^branch /{b=substr($0,19)} /^$/{if (n++) print p "\t" b}' |
  while IFS=$'\t' read -r path branch; do
    merged=no; [ -n "$branch" ] && git merge-base --is-ancestor "refs/heads/$branch" refs/heads/main && merged=yes
    clean=no; st="$(git -C "$path" status --porcelain --ignored 2>/dev/null)" && [ -z "$st" ] && clean=yes
    inuse=no; printf '%s\n' "$cwds" | awk -v p="$path" '$0 == p || index($0, p "/") == 1 {f=1} END {exit !f}' && inuse=yes
    # Claude keeps a directory's transcripts under projects/<path with non-alphanumerics as ->.
    # The -* also matches a sibling worktree's name; that errs towards keeping it.
    tdir="$(printf '%s' "$path" | sed 's/[^A-Za-z0-9]/-/g')"
    [ -n "$(find "$1/projects" -mindepth 2 -maxdepth 2 \( -path "*/$tdir/*" -o -path "*/$tdir-*/*" \) -mmin -1440 -print -quit 2>/dev/null)" ] && inuse=yes
    printf '%s\t%s\t%s\t%s\t%s\n' "$path" "${branch:-(detached)}" "$merged" "$clean" "$inuse"
  done
}

worktrees() {  # <config dir> <workdir>
  local list
  list="$(scan "$1" "$2")"
  printf '%s' "$list" | awk -F'\t' 'BEGIN {printf "%-6s  %-5s  %-6s  %-40s  %s\n", "MERGED", "CLEAN", "IN USE", "BRANCH", "PATH"}
    {printf "%-6s  %-5s  %-6s  %-40s  %s\n", $3, $4, $5, $2, $1; n++} END {if (!n) print "no worktrees"}'
}

# git itself refuses to remove a dirty worktree or delete an unmerged branch: each check holds twice.
prune() {  # <config dir> <workdir>
  local list n=0 path branch out
  list="$(scan "$1" "$2")"
  while IFS=$'\t' read -r path branch; do
    git -C "$2" worktree remove "$path" || continue
    n=$((n + 1))
    if out="$(git -C "$2" branch -d "$branch" 2>&1)"; then echo "removed $branch"
    else echo "removed the $branch worktree; kept the branch: $out"; fi
  done < <(printf '%s\n' "$list" | awk -F'\t' '$3 == "yes" && $4 == "yes" && $5 == "no" {print $1 "\t" $2}')
  echo "pruned $n worktree(s)"
}

if [ "${1:-}" = --as-profile ]; then  # <cmd> <config dir> <workdir>, already the profile user
  case "$2" in sessions) sessions "$3" ;; worktrees) worktrees "$3" "$4" ;; prune) prune "$3" "$4" ;; esac
  exit
fi

PROFILE="${1:?profile}"; cmd="${2:?sessions|worktrees|prune}"
[[ $PROFILE =~ ^[a-z0-9-]+$ ]] || { echo "bad profile" >&2; exit 2; }
case "$cmd" in sessions|worktrees|prune) ;; *) echo "unknown command $cmd" >&2; exit 2 ;; esac
# Only the two paths reach the profile, not the ntfy token. Read as systemd does: outer
# whitespace trimmed, one pair of enclosing quotes removed.
env_file="/etc/claude-rc/$PROFILE.env"
val() { sed -n "s/^$1=//p" "$env_file" | sed -E "s/^[[:space:]]+|[[:space:]]+\$//g; s/^\"(.*)\"\$/\1/; s/^'(.*)'\$/\1/"; }
config="$(val CLAUDE_CONFIG_DIR)"; workdir="$(val WORKDIR)"
: "${config:?no CLAUDE_CONFIG_DIR in $env_file}" "${workdir:?no WORKDIR in $env_file}"
cd /
exec runuser -u "$PROFILE" -- env -i PATH=/usr/bin:/bin HOME="/home/$PROFILE" "$(readlink -f "$0")" --as-profile "$cmd" "$config" "$workdir"
