# /etc/claude-rc/cc-work.env  (mode 0640 root:cc-lab; NOT in git)
# Optional second profile. Team/Enterprise accounts need an Owner to enable Remote Control first.

CLAUDE_CONFIG_DIR=/home/cc-work/.claude-cc-work
WORKDIR=/mnt/lab/work
RC_NAME=work-claude-gw
RC_SPAWN=worktree
RC_CAPACITY=8
RC_PERMISSION_MODE=acceptEdits

NTFY_URL=https://ntfy.sh
NTFY_TOPIC=lab-claude-work-CHANGEME
NTFY_TOKEN=tk_CHANGEME
