# /etc/claude-rc/cc-home.env  (mode 0640 root:cc-lab; NOT in git)
# Loaded by claude-rc@cc-home.service, rc-start, rc-health, rc-alert, ntfy-send.
# Comments on their own lines only: systemd EnvironmentFile keeps inline "# ..." as part of the value.

CLAUDE_CONFIG_DIR=/home/cc-home/.claude-cc-home
# must be a git repo for RC_SPAWN=worktree
WORKDIR=/mnt/lab/home
# device/session card name in the Claude app
RC_NAME=home-claude-gw
# worktree | same-dir
RC_SPAWN=worktree
RC_CAPACITY=16
# never bypassPermissions on the gateway
RC_PERMISSION_MODE=acceptEdits

NTFY_URL=https://ntfy.sh
# long random suffix; topics are public namespaces
NTFY_TOPIC=lab-claude-home-CHANGEME
# ntfy.sh access token with publish on this topic
NTFY_TOKEN=tk_CHANGEME
