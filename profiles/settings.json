{
  "permissions": {
    "disableBypassPermissionsMode": "disable",
    "deny": [
      "Read(/etc/claude-rc/**)",
      "Bash(sudo *)",
      "Bash(rm -rf /*)"
    ]
  },
  "hooks": {
    "Notification": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/local/lib/claude-rc/hooks/ntfy-notify.sh",
            "timeout": 15
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/local/lib/claude-rc/hooks/handover.sh",
            "timeout": 20
          }
        ]
      }
    ]
  }
}
